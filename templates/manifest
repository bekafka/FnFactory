# fnOS 应用 manifest 模板 —— 三个作者按 specs/authorship.md 填，别删字段
# 占位符清单见 templates/README.md；版本/架构/更新日志由 FnFactory 流水线注入
appname               = @APPNAME@
version               = ${VERSION}
display_name          = @DISPLAY_NAME@
desc                  = "<p>@DESC@</p><p>源作者：<a href='@SOURCE_AUTHOR_URL@'>@SOURCE_AUTHOR@</a>（上游项目，最初的创造者与权利源头）；本包由 bekafka 打包适配。</p>"
platform              = ${PLATFORM}
source                = thirdparty

# ── 三个作者（specs/authorship.md）─────────────────────────────────────────
# 开发者：做 fnOS 适配、写生命周期脚本、打包的人
maintainer            = bekafka
maintainer_url        = https://github.com/bekafka/FnDepot
# 发布者：把 .fpk 发出来、维护应用源的人
distributor           = bekafka
distributor_url       = https://github.com/bekafka/FnDepot
# 源作者：上游项目最初的创造者与权利源头（项目主页，不带 /releases）
source_author         = @SOURCE_AUTHOR@
source_author_url     = @SOURCE_AUTHOR_URL@

desktop_uidir         = ui
desktop_applaunchname = @APPNAME@.main
ctl_stop              = true
checkport             = false
disable_authorization_path = false
# changelog 必须单行（流水线会把多行折成 " · "；fnpack 不认多行值）
changelog             = ${CHANGELOG}
